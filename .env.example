# ==========================================================
# Container timezone
# ==========================================================
TZ=Europe/Berlin

# ==========================================================
# Temporary processing folder
# ==========================================================
FOLDER_PROCESS=/volume1/docker-ssd/opencloud-ocrmypdf/process

# ==========================================================
# Watcher behavior
# ==========================================================
# Host-side scan root to mount into the container.
# This folder must contain subfolders for the scan targets, for example daniela/ and denis/.
# The subfolder names are configured via SCAN_MAPPING__..._SOURCE.
SCAN_ROOT_HOST=/volume1/docker-ssd/opencloud-ocrmyscan/scan
# Event-based directory monitoring: when a new PDF appears, it is processed within up to 10 seconds.
# This is not a periodic scan of the folders.
WATCHER_POLL_INTERVAL=10
# Safety fallback: after the container starts, all existing PDFs are checked once.
# If set to a value greater than 0, the same check is repeated every N minutes as a backup.
# Set to 0 to disable the periodic re-check.
WATCHER_REPROCESS_INTERVAL_MINUTES=0

# ==========================================================
# Tesseract packages
# ==========================================================
# Install the language data packages that Tesseract should use for OCR.
# Example: TESSERACT_PACKAGES=tesseract-ocr-deu tesseract-ocr-eng tesseract-ocr-fra
TESSERACT_PACKAGES=tesseract-ocr-deu tesseract-ocr-eng

# ==========================================================
# OCR behavior
# ==========================================================
# Documentation: https://ocrmypdf.readthedocs.io/en/latest/cookbook.html

# Languages to use for OCR recognition (space-separated, e.g. deu eng fra)
OCR_LANGUAGES=deu eng
# Will correct pages that were scanned at a skewed angle by rotating them back into place.
OCR_DESKEW=true
# Attempts to determine the correct orientation for each page and rotates the page if necessary.
OCR_ROTATE_PAGES=true
# uses unpaper to clean up pages before OCR, but does not alter the final output. This makes it less likely that OCR will try to find text in background noise.
OCR_CLEAN=true
# Uses unpaper to clean up pages before OCR and inserts the page into the final output. You will want to review each page to ensure that unpaper did not remove something important.
OCR_CLEAN_FINAL=false
# Attempts to detect and remove a noisy background from grayscale or color images. Monochrome images are ignored. This should not be used on documents that contain color photos as it may remove them.
# This option is currently disabled because OCRmyPDF does not support it reliably in this environment.
OCR_REMOVE_BACKGROUND=false
# If --skip-text is issued, then no OCR will be performed on pages that already have text. The page will be copied to the output. This may be useful for documents that contain both “born digital” and scanned content, or to use OCRmyPDF to normalize and convert to PDF/A regardless of their contents.
OCR_SKIP_TEXT=true
# If --redo-ocr is issued, then a detailed text analysis is performed. Text is categorized as either visible or invisible. Invisible text (OCR) is stripped out. Then an image of each page is created with visible text masked out. The page image is sent for OCR, and any additional text is inserted as OCR. If a file contains a mix of text and bitmap images that contain text, OCRmyPDF will locate the additional text in images without disrupting the existing text.
OCR_REDO_OCR=false
# If --force-ocr is issued, then all pages will be rasterized to images, discarding any hidden OCR text, and rasterizing any printable text. This is useful for redoing OCR, for fixing OCR text with a damaged character map (text is selectable but not searchable), and destroying redacted information. Any forms and vector graphics will be rasterized as well.
OCR_FORCE_OCR=false

# ==========================================================
# WebDAV settings
# ==========================================================
# OpenCloud credentials for uploads
# Note: For OpenCloud WebDAV, the password field may need to contain a personal access token
# generated in the OpenCloud user settings, because the regular password is often not accepted.
WEBDAV_USER=ScanUser
WEBDAV_PASSWORD=Create a token in the user's app-tokens settings

# ==========================================================
# Scan source -> WebDAV target mapping
# ==========================================================
# Only the folder name or a relative subfolder under the central scan root is needed.
SCAN_MAPPING__DANIELA_SOURCE=daniela
SCAN_MAPPING__DANIELA_TARGET=https://opencloud.MyDomain.com/dav/Daniela

SCAN_MAPPING__DENIS_SOURCE=denis
SCAN_MAPPING__DENIS_TARGET=https://opencloud.MyDomain.com/dav/spaces/<SpaceId>/Denis
