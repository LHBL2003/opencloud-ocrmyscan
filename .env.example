# ==========================================================
# Basic configuration
# Configure these values for a new installation.
# ==========================================================

# Example host folder for temporary OCR output before upload. Replace with your path.
FOLDER_PROCESS=/volume1/docker-ssd/opencloud-ocrmyscan/process

# Example host-side scan root. Its subfolders are configured in mappings.yaml.
SCAN_ROOT_HOST=/volume1/docker-ssd/opencloud-ocrmyscan/scan

# Example persistent folder containing mappings.yaml. The file is mounted read-only.
CONFIG_DIR_HOST=/volume1/docker-ssd/opencloud-ocrmyscan/config

# OpenCloud credentials for uploads. Use a personal app token as the password.
WEBDAV_USER=ScanUser
WEBDAV_PASSWORD=Create a token in the user's app-tokens settings

# Scan source -> WebDAV target mappings are configured in
# CONFIG_DIR_HOST/mappings.yaml (see config/mappings.yaml.example in this repository).

# ==========================================================
# Optional and advanced configuration
# Change these only when the defaults do not fit your setup.
# ==========================================================

# Container timezone
TZ=Europe/Berlin

# Watcher behavior
# After startup, existing PDFs are checked once. This is repeated every 24 hours.
# Set the value to 0 to disable the periodic re-check.
WATCHER_SAFETY_RECHECK_INTERVAL_MINUTES=1440

# Tesseract packages (requires an image rebuild after changing this value).
# Example: TESSERACT_PACKAGES=tesseract-ocr-deu tesseract-ocr-eng tesseract-ocr-fra
TESSERACT_PACKAGES=tesseract-ocr-deu tesseract-ocr-eng

# OCR behavior
# Documentation: https://ocrmypdf.readthedocs.io/en/latest/cookbook.html

# Languages to use for OCR recognition (space-separated, e.g. deu eng fra)
OCR_LANGUAGES=deu eng
# Will correct pages that were scanned at a skewed angle by rotating them back into place.
OCR_DESKEW=true
# Attempts to determine the correct orientation for each page and rotates the page if necessary.
OCR_ROTATE_PAGES=true
# Cleans pages only before OCR and does not alter the final PDF. This helps avoid false OCR text from background noise, for example text showing through from the reverse side.
OCR_CLEAN=true
# Uses unpaper to clean up pages before OCR and inserts the page into the final output. Review each page carefully, as details may be removed.
OCR_CLEAN_FINAL=false
# Attempts to detect and remove a noisy background from grayscale or color images. This option is currently disabled because OCRmyPDF does not support it reliably in this environment.
OCR_REMOVE_BACKGROUND=false
# Leaves pages that already contain text unchanged.
OCR_SKIP_TEXT=true
# Recreates an existing invisible or damaged OCR text layer.
OCR_REDO_OCR=false
# Recreates OCR for every page and replaces existing text layers.
OCR_FORCE_OCR=false
